# Local development only. On Render, add these in Environment Variables.
TOKEN=
MONGO_URI=
ERLC_SERVER_KEY=
LLC_CHANNEL_ID=
MELONLY_API_TOKEN=

# Melonly server API token — created from your server's Panel settings in
# the Melonly dashboard (Server API Tokens). Used for /test-melonly and any
# future Melonly integrations. Docs: https://apidocs.melonly.xyz/

# Command logs are polled from GET /v2/server?CommandLogs=true using
# ERLC_SERVER_KEY (see poll_erlc_command_logs in bot.py) — NOT delivered via
# the Event Webhook below, which only sends ";"-prefixed chat messages and
# Emergency Calls.

# ER:LC Event Webhook
# Do NOT put an ER:LC server key here.
# In your ER:LC private-server settings, the Event Webhook URL should point
# to your public Render endpoint, for example:
# https://YOUR-SERVICE.onrender.com/erlc/events
